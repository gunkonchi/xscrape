# --- Authentication ---
XSCRAPE_COOKIES="auth_token=YOUR_TOKEN; ct0=YOUR_CT0"
XSCRAPE_POOL="accounts.json"

# --- Networking ---
XSCRAPE_CONCURRENCY=4
XSCRAPE_TIMEOUT=20
XSCRAPE_RETRIES=3
XSCRAPE_PROXY=
XSCRAPE_USER_AGENT="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36"

# --- Logging ---
XSCRAPE_LOG_LEVEL=INFO
XSCRAPE_LOG_FORMAT=text
